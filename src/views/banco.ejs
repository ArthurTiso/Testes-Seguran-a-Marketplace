<%- include('partials/header', { titulo: 'Banco de Dados', refresh: 15 }) %>
<h2>Painel do Banco de Dados <span class="small">(atualiza sozinho a cada 15s)</span></h2>

<% if (typeof stats !== 'undefined') { %>
<div class="kpis">
  <div class="kpi"><div class="kpi-num"><%= stats.usuarios %></div><div class="kpi-lbl">Usuários cadastrados</div></div>
  <div class="kpi"><div class="kpi-num"><%= stats.produtos %></div><div class="kpi-lbl">Produtos</div></div>
  <div class="kpi"><div class="kpi-num"><%= stats.pedidos %></div><div class="kpi-lbl">Pedidos realizados</div></div>
  <div class="kpi"><div class="kpi-num">R$ <%= stats.vendas.toFixed(2).replace('.', ',') %></div><div class="kpi-lbl">Total em vendas</div></div>
  <div class="kpi"><div class="kpi-num"><%= stats.avaliacoes %></div><div class="kpi-lbl">Avaliações</div></div>
  <div class="kpi"><div class="kpi-num"><%= stats.admins %></div><div class="kpi-lbl">Administradores</div></div>
</div>
<% } %>

<p class="small">Resumo em tempo real do sistema. Para conferir os registros
(senhas em <strong>bcrypt</strong>, CPF/cartão <strong>cifrados</strong>),
abra o detalhe das tabelas.</p>
<a id="abrir-tabelas" href="/admin/banco?t=usuarios" class="btn">🔍 Ver detalhe das tabelas</a>

<!-- ===== Modal: detalhe das tabelas ===== -->
<div id="modal-tabelas" class="modal">
  <div class="modal-bg" data-fechar></div>
  <div class="modal-box">
    <div class="modal-head">
      <h3 style="margin:0">Detalhe das tabelas <span class="small">(somente leitura)</span></h3>
      <button type="button" class="btn-sec" data-fechar>Fechar ✕</button>
    </div>
    <div class="modal-body">
      <div style="display:flex;gap:1rem;flex-wrap:wrap">
        <!-- Menu de tabelas -->
        <div class="card" style="min-width:190px;margin:0">
          <h4 style="margin-top:0">Tabelas</h4>
          <% TABELAS.forEach(t => { %>
            <div style="margin:.2rem 0">
              <a href="/admin/banco?t=<%= t %>" style="<%= t === tabela ? 'font-weight:700' : '' %>"><%= t %></a>
              <span class="badge"><%= contagens[t] %></span>
            </div>
          <% }) %>
        </div>
        <!-- Conteúdo da tabela -->
        <div class="card" style="flex:1;overflow:auto;margin:0">
          <h4 style="margin-top:0"><code><%= tabela %></code> <span class="small">(até 200 registros)</span></h4>
          <% if (!linhas.length) { %>
            <p class="small">Tabela vazia.</p>
          <% } else { %>
            <div style="overflow:auto;max-width:100%">
              <table>
                <thead><tr><% colunas.forEach(c => { %><th><%= c %></th><% }) %></tr></thead>
                <tbody>
                  <% linhas.forEach(row => { %>
                    <tr>
                      <% colunas.forEach(c => { var v = row[c]; %>
                        <td style="max-width:280px;word-break:break-all;font-size:.82rem">
                          <% if (v === null || v === undefined) { %><span class="small">NULL</span>
                          <% } else if (v instanceof Date) { %><%= v.toLocaleString('pt-BR') %>
                          <% } else { %><%= String(v) %><% } %>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
          <p class="small" style="margin-top:.8rem">Acesso restrito ao administrador e somente leitura.
            O nome da tabela é validado por lista fixa (sem SQL Injection).</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/static/js/banco.js" defer></script>
<%- include('partials/footer') %>
