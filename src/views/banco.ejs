<%- include('partials/header', { titulo: 'Banco de Dados', refresh: 15 }) %>
<h2>Painel do Banco de Dados <span class="small">(atualiza sozinho a cada 15s)</span></h2>

<% if (typeof stats !== 'undefined') { %>
<div class="kpis">
  <div class="kpi"><div class="kpi-num"><%= stats.usuarios %></div><div class="kpi-lbl">Usuários cadastrados</div></div>
  <div class="kpi"><div class="kpi-num"><%= stats.produtos %></div><div class="kpi-lbl">Produtos</div></div>
  <div class="kpi"><div class="kpi-num"><%= stats.pedidos %></div><div class="kpi-lbl">Pedidos realizados</div></div>
  <div class="kpi"><div class="kpi-num">R$ <%= stats.vendas.toFixed(2).replace('.', ',') %></div><div class="kpi-lbl">Total em vendas</div></div>
  <div class="kpi"><div class="kpi-num"><%= stats.avaliacoes %></div><div class="kpi-lbl">Avaliações</div></div>
  <div class="kpi"><div class="kpi-num"><%= stats.admins %></div><div class="kpi-lbl">Administradores</div></div>
</div>
<% } %>

<p class="small">Resumo em tempo real do sistema. Abaixo, o detalhe das tabelas do MySQL
(somente leitura) — note que <strong>senhas estão em bcrypt</strong> e
<strong>CPF/cartão estão cifrados</strong>.</p>
<h3 style="margin:.6rem 0 .4rem">Detalhe das tabelas</h3>

<div style="display:flex;gap:1rem;flex-wrap:wrap">
  <!-- Menu de tabelas -->
  <div class="card" style="min-width:200px">
    <h3 style="margin-top:0">Tabelas</h3>
    <% TABELAS.forEach(t => { %>
      <div style="margin:.2rem 0">
        <a href="/admin/banco?t=<%= t %>"
           style="<%= t === tabela ? 'font-weight:700' : '' %>">
          <%= t %></a>
        <span class="badge"><%= contagens[t] %></span>
      </div>
    <% }) %>
  </div>

  <!-- Conteúdo da tabela -->
  <div class="card" style="flex:1;overflow:auto">
    <h3 style="margin-top:0">
      <code><%= tabela %></code>
      <span class="small">(mostrando até 200 registros)</span>
    </h3>
    <% if (!linhas.length) { %>
      <p class="small">Tabela vazia.</p>
    <% } else { %>
      <div style="overflow:auto;max-width:100%">
        <table>
          <thead>
            <tr><% colunas.forEach(c => { %><th><%= c %></th><% }) %></tr>
          </thead>
          <tbody>
            <% linhas.forEach(row => { %>
              <tr>
                <% colunas.forEach(c => { var v = row[c]; %>
                  <td style="max-width:280px;word-break:break-all;font-size:.82rem">
                    <% if (v === null || v === undefined) { %>
                      <span class="small">NULL</span>
                    <% } else if (v instanceof Date) { %>
                      <%= v.toLocaleString('pt-BR') %>
                    <% } else { %>
                      <%= String(v) %>
                    <% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<p class="small" style="margin-top:1rem">
  Acesso restrito ao administrador e somente leitura. O nome da tabela é
  validado por lista fixa (sem SQL Injection).
</p>
<%- include('partials/footer') %>
