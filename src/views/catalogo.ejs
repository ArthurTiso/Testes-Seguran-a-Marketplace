<%- include('partials/header', { titulo: 'Produtos', busca: busca }) %>

<section class="promo">
  <div>
    <h1>Ofertas em Tecnologia 🚀</h1>
    <p>Frete grátis em milhares de produtos · Compra segura · Entrega rápida</p>
  </div>
  <span class="selo">★ Loja oficial IFSP</span>
</section>

<div style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:.8rem">
  <h2 style="margin:0"><%= busca ? 'Resultados para "' + busca + '"' : 'Produtos em destaque' %></h2>
  <span class="small"><%= produtos.length %> produto(s)</span>
</div>

<% if (typeof debugSql !== 'undefined' && debugSql) { %>
  <div class="mono">SQL executado (modo vulnerável): <%= debugSql %></div>
<% } %>

<% if (!produtos.length) { %>
  <div class="card"><p>Nenhum produto encontrado.</p></div>
<% } else { %>
  <div class="market-grid">
    <% produtos.forEach(p => { %>
      <div class="prod-card">
        <a class="prod-thumb" href="/produto/<%= p.id %>"><%- include('partials/thumb', { nome: p.nome }) %></a>
        <div class="prod-info">
          <a class="prod-title" href="/produto/<%= p.id %>"><%- escapeHtml(p.nome) %></a>
          <div class="stars">★★★★<span class="dim">★</span> <span>(<%= 20 + (p.id * 37) % 480 %>)</span></div>
          <div class="price-lg">R$ <%= Number(p.preco).toFixed(2).replace('.', ',') %></div>
          <% if (Number(p.preco) >= 100) { %><div class="tag-frete">Frete grátis</div><% } else { %><div class="tag-frete">Chega rápido</div><% } %>
          <div class="prod-estoque"><%= p.estoque > 0 ? p.estoque + ' em estoque' : 'Indisponível' %></div>
          <form action="/carrinho/adicionar" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="produtoId" value="<%= p.id %>">
            <button type="submit" class="btn-add">Adicionar ao carrinho</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
<%- include('partials/footer') %>
