<%- include('partials/header', { titulo: produto.nome }) %>
<p class="small" style="margin:.2rem 0 .8rem"><a href="/">← Voltar aos produtos</a></p>
<div class="card">
  <div class="produto-detalhe">
    <div class="produto-foto"><%- include('partials/thumb', { nome: produto.nome }) %></div>
    <div>
      <h2 style="margin-top:0"><%- escapeHtml(produto.nome) %></h2>
      <div class="stars" style="margin-bottom:.4rem">★★★★<span class="dim">★</span> <span>(<%= 20 + (produto.id * 37) % 480 %> avaliações)</span></div>
      <p><%- escapeHtml(produto.descricao || '') %></p>
      <p class="price-lg" style="margin:.4rem 0">R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></p>
      <% if (Number(produto.preco) >= 100) { %><p class="tag-frete">✓ Frete grátis para todo o Brasil</p><% } %>
      <p class="prod-estoque">Vendido por <%- escapeHtml(produto.vendedor) %> · <%= produto.estoque %> em estoque</p>
      <form action="/carrinho/adicionar" method="post" style="display:flex;gap:.5rem;max-width:340px;margin-top:.6rem">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="produtoId" value="<%= produto.id %>">
        <input type="number" name="quantidade" value="1" min="1" style="width:84px">
        <button type="submit" style="flex:1">Adicionar ao carrinho</button>
      </form>
    </div>
  </div>
</div>

<div class="card">
  <h3>Avaliações</h3>
  <% if (!avaliacoes.length) { %><p class="small">Ainda não há avaliações.</p><% } %>
  <% avaliacoes.forEach(a => { %>
    <div style="border-bottom:1px solid #eee;padding:.4rem 0">
      <strong><%- escapeHtml(a.autor) %></strong> — nota <%= a.nota %>/5
      <div><%- escapeHtml(a.comentario || '') %></div>
    </div>
  <% }) %>

  <% if (usuario) { %>
    <h4 style="margin-top:1rem">Deixe sua avaliação</h4>
    <form action="/produto/<%= produto.id %>/avaliar" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Nota</label>
      <select name="nota"><% for(let i=5;i>=1;i--){ %><option value="<%= i %>"><%= i %></option><% } %></select>
      <label>Comentário</label>
      <textarea name="comentario" rows="3"></textarea>
      <div style="margin-top:.6rem"><button type="submit">Enviar avaliação</button></div>
    </form>
  <% } else { %>
    <p class="small"><a href="/login">Entre</a> para avaliar.</p>
  <% } %>
</div>
<%- include('partials/footer') %>
