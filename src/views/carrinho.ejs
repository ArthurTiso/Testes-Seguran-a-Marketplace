<%- include('partials/header', { titulo: 'Carrinho' }) %>
<h2>Seu carrinho</h2>
<% if (!itens.length) { %>
  <p>Carrinho vazio. <a href="/">Ver produtos</a></p>
<% } else { %>
  <div class="card">
    <table>
      <tr><th>Produto</th><th>Qtd</th><th class="right">Subtotal</th><th></th></tr>
      <% itens.forEach(i => { %>
        <tr>
          <td><%- escapeHtml(i.produto.nome) %></td>
          <td><%= i.qtd %></td>
          <td class="right">R$ <%= i.subtotal.toFixed(2) %></td>
          <td>
            <form action="/carrinho/remover" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="produtoId" value="<%= i.produto.id %>">
              <button class="btn-perigo" style="padding:.3rem .6rem">Remover</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <tr><th colspan="2">Total</th><th class="right">R$ <%= total.toFixed(2) %></th><th></th></tr>
    </table>
    <div style="margin-top:1rem">
      <% if (usuario) { %>
        <a class="btn" href="/checkout">Finalizar compra</a>
      <% } else { %>
        <a class="btn" href="/login?next=/checkout">Entre para finalizar</a>
      <% } %>
    </div>
  </div>
<% } %>
<%- include('partials/footer') %>
