<%- include('partials/header', { titulo: 'Entrar' }) %>
<div class="card" style="max-width:420px;margin:2rem auto">
  <h2>Entrar</h2>
  <% if (erro) { %><div class="alerta alerta-erro"><%= erro %></div><% } %>
  <form action="/login" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>E-mail</label>
    <input type="email" name="email" required autofocus>
    <label>Senha</label>
    <input type="password" name="senha" required>
    <div style="margin-top:1rem"><button type="submit">Entrar</button></div>
  </form>
  <p class="small" style="margin-top:1rem">Não tem conta? <a href="/cadastro">Cadastre-se</a></p>

  <div style="border-top:1px solid var(--border);margin:1rem 0 .8rem;padding-top:.9rem">
    <form action="/demo/admin" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn-sec" style="width:100%">🔑 Entrar como Administrador</button>
    </form>
    <p class="small" style="margin-top:.5rem;text-align:center">Acesso rápido à visão administrativa (demonstração).</p>
  </div>
</div>
<%- include('partials/footer') %>
