# Serviço systemd do Marketplace.
# Copie para /etc/systemd/system/marketplace.service e:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now marketplace
# Ajuste User, WorkingDirectory e o caminho do node conforme a VM.

[Unit]
Description=Marketplace IFSP (Node.js)
After=network.target mariadb.service mysql.service

[Service]
Type=simple
User=marketplace
WorkingDirectory=/opt/marketplace
EnvironmentFile=/opt/marketplace/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
# Endurecimento do serviço
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
